<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/create_event_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/event_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/create_back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_event"
            android:textColor="@color/event_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/create_step_one"
                android:textColor="@color/event_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/event_details"
                android:textColor="@color/event_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/event_name_label"
                android:labelFor="@id/create_event_name"
                style="@style/CreateEventFieldLabel"
                android:layout_marginTop="24dp"
                android:text="@string/create_event_name" />

            <EditText
                android:id="@+id/create_event_name"
                style="@style/CreateEventField"
                android:inputType="textCapSentences" />

            <TextView
                android:id="@+id/event_venue_label"
                android:labelFor="@id/create_event_venue"
                style="@style/CreateEventFieldLabel"
                android:text="@string/create_event_venue" />

            <EditText
                android:id="@+id/create_event_venue"
                style="@style/CreateEventField"
                android:inputType="textCapWords" />

            <TextView
                android:id="@+id/event_start_label"
                android:labelFor="@id/create_event_start"
                style="@style/CreateEventFieldLabel"
                android:text="@string/create_event_start" />

            <EditText
                android:id="@+id/create_event_start"
                style="@style/CreateEventField"
                android:hint="@string/date_time_hint"
                android:inputType="text" />

            <TextView
                android:id="@+id/event_end_label"
                android:labelFor="@id/create_event_end"
                style="@style/CreateEventFieldLabel"
                android:text="@string/create_event_end" />

            <EditText
                android:id="@+id/create_event_end"
                style="@style/CreateEventField"
                android:hint="@string/date_time_hint"
                android:inputType="text" />

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/create_next_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="@string/next"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/event_navy"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
