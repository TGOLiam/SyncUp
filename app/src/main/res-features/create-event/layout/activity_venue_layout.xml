<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/venue_layout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/event_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/venue_back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_event"
            android:textColor="@color/event_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <include layout="@layout/create_event_progress" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@drawable/venue_canvas">

            <com.example.sync_up.VenueDrawingView
                android:id="@+id/venue_drawing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/venue_drawing_description" />

            <EditText
                android:id="@+id/venue_zone_name"
                android:layout_width="200dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/join_code_field"
                android:hint="@string/zone_name_hint"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="@color/event_text"
                android:textColorHint="@color/event_muted"
                android:visibility="gone" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/venue_draw_button"
                style="@style/VenueToolButton"
                android:text="@string/venue_draw"
                app:backgroundTint="@color/venue_selected" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/venue_edit_button"
                style="@style/VenueToolButton"
                android:layout_marginStart="6dp"
                android:text="@string/venue_edit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/venue_undo_button"
                style="@style/VenueToolButton"
                android:layout_marginStart="6dp"
                android:text="@string/venue_undo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/venue_straighten_button"
                style="@style/VenueToolButton"
                android:layout_marginStart="6dp"
                android:text="@string/venue_straighten" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/venue_add_zone_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/venue_add_zone"
            android:textAllCaps="false"
            android:textColor="@color/event_navy"
            app:cornerRadius="10dp"
            app:strokeColor="@color/event_navy" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/venue_footer_back_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/back"
            android:textAllCaps="false"
            android:textColor="@color/event_navy"
            app:cornerRadius="12dp"
            app:strokeColor="@color/event_navy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/venue_next_button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/next"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/event_navy"
            app:cornerRadius="12dp" />
    </LinearLayout>
</LinearLayout>
