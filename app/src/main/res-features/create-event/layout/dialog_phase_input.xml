<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        style="@style/CreateEventFieldLabel"
        android:labelFor="@id/phase_input_label"
        android:text="@string/phase_label" />

    <EditText
        android:id="@+id/phase_input_label"
        style="@style/CreateEventField"
        android:inputType="textCapSentences" />

    <TextView
        style="@style/CreateEventFieldLabel"
        android:labelFor="@id/phase_input_hours"
        android:text="@string/phase_hours" />

    <EditText
        android:id="@+id/phase_input_hours"
        style="@style/CreateEventField"
        android:inputType="number" />

    <TextView
        style="@style/CreateEventFieldLabel"
        android:labelFor="@id/phase_input_minutes"
        android:text="@string/phase_minutes" />

    <EditText
        android:id="@+id/phase_input_minutes"
        style="@style/CreateEventField"
        android:inputType="number" />
</LinearLayout>
