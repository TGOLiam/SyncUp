<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_ui_wash"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/phase_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ui_ink"
            android:textSize="16sp"
            android:fontFamily="@font/dm_sans_600" />

        <TextView
            android:id="@+id/phase_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ui_secondary_text"
            android:textSize="14sp" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/phase_edit_button"
        style="@style/Widget.Ui.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minWidth="48dp"
        android:text="@string/venue_edit"
         />

    <ImageButton
        android:id="@+id/phase_remove_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/remove_phase"
        android:padding="14dp"
        android:src="@drawable/ic_ui_close" />
</LinearLayout>
