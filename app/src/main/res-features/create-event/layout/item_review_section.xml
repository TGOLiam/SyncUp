<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:text="@string/review_checkmark"
        android:textColor="@color/event_text"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/review_section_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/event_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/review_section_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/event_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/review_section_edit"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minWidth="64dp"
        android:text="@string/venue_edit"
        android:textAllCaps="false"
        android:textColor="@color/event_navy"
        app:cornerRadius="10dp"
        app:strokeColor="@color/event_navy" />
</LinearLayout>
