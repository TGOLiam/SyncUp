<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/channels_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">
            <include layout="@layout/create_event_progress" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/venue_canvas"
                android:minHeight="56dp"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:text="@string/channel_global"
                android:textColor="@color/event_text"
                android:textSize="16sp" />
            <LinearLayout
                android:id="@+id/channel_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_channel_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="@string/add_custom_channel"
                android:textAllCaps="false"
                android:textColor="@color/event_navy"
                app:cornerRadius="10dp"
                app:strokeColor="@color/event_navy" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/channels_footer_back_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/back"
            android:textAllCaps="false"
            android:textColor="@color/event_navy"
            app:cornerRadius="12dp"
            app:strokeColor="@color/event_navy" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/channels_review_button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/review"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/event_navy"
            app:cornerRadius="12dp" />
    </LinearLayout>
</LinearLayout>