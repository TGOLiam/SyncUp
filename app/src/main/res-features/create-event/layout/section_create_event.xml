<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/create_event_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">
            <include layout="@layout/create_event_progress" />
            <TextView
                android:id="@+id/event_name_label"
                android:labelFor="@id/create_event_name"
                style="@style/CreateEventFieldLabel"
                android:layout_marginTop="24dp"
                android:text="@string/create_event_name" />
            <EditText
                android:id="@+id/create_event_name"
                style="@style/CreateEventField"
                android:inputType="textCapSentences" />
            <TextView
                android:id="@+id/event_venue_label"
                android:labelFor="@id/create_event_venue"
                style="@style/CreateEventFieldLabel"
                android:text="@string/create_event_venue" />
            <EditText
                android:id="@+id/create_event_venue"
                style="@style/CreateEventField"
                android:inputType="textCapWords" />
            <TextView
                android:id="@+id/event_start_label"
                android:labelFor="@id/create_event_start"
                style="@style/CreateEventFieldLabel"
                android:text="@string/create_event_start" />
            <EditText
                android:id="@+id/create_event_start"
                style="@style/CreateEventField"
                android:hint="@string/date_hint"
                android:focusable="false"
                android:clickable="true"
                android:inputType="date" />
            <TextView
                android:id="@+id/event_end_label"
                android:labelFor="@id/create_event_end"
                style="@style/CreateEventFieldLabel"
                android:text="@string/create_event_end" />
            <EditText
                android:id="@+id/create_event_end"
                style="@style/CreateEventField"
                android:hint="@string/date_hint"
                android:focusable="false"
                android:clickable="true"
                android:inputType="date" />
            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/create_next_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="@string/next"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/event_navy"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>