<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/event_phases_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_surface"
    android:orientation="vertical">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">
            <include layout="@layout/create_event_progress" />
            <TextView
                style="@style/CreateEventFieldLabel"
                android:layout_marginTop="20dp"
                android:text="@string/phase_event_start_date" />
            <TextView
                android:id="@+id/phases_event_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ui_ink"
                android:textSize="16sp" />
            <TextView
                style="@style/CreateEventFieldLabel"
                android:labelFor="@id/phases_start_time"
                android:text="@string/phase_event_start_time" />
            <EditText
                android:id="@+id/phases_start_time"
                style="@style/CreateEventField"
                android:hint="@string/phase_select_time"
                android:focusable="false"
                android:clickable="true"
                android:inputType="time" />
            <TextView
                android:id="@+id/phases_start_time_error"
                style="@style/PhaseValidationError"
                android:text="@string/event_details_required" />
            <TextView
                style="@style/CreateEventFieldLabel"
                android:labelFor="@id/phases_end_time"
                android:text="@string/phase_event_end_time" />
            <EditText
                android:id="@+id/phases_end_time"
                style="@style/CreateEventField"
                android:hint="@string/phase_select_time"
                android:focusable="false"
                android:clickable="true"
                android:inputType="time" />
            <TextView
                android:id="@+id/phases_end_time_error"
                style="@style/PhaseValidationError"
                android:text="@string/event_details_required" />
            <LinearLayout
                android:id="@+id/phase_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/add_phase_button"
            style="@style/Widget.Ui.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/add_phase"
                android:textColor="@color/ui_green" />
            <TextView
                android:id="@+id/phases_list_error"
                style="@style/PhaseValidationError"
                android:text="@string/phase_required" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/phases_help"
                android:textColor="@color/ui_secondary_text"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/phases_footer_back_button"
            style="@style/Widget.Ui.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:text="@string/back"
            android:textColor="@color/ui_green" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/phases_next_button"
            style="@style/Widget.Ui.Button.Orange"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/next"
            android:textColor="@color/ui_surface" />
    </LinearLayout>
</LinearLayout>