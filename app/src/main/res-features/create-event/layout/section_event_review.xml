<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/event_review_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_surface"
    android:orientation="vertical">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">
            <include layout="@layout/create_event_progress" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/review_heading"
                android:textColor="@color/ui_ink"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/review_subtitle"
                android:textColor="@color/ui_secondary_text"
                android:textSize="14sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ui_wash"
                android:orientation="vertical"
                android:padding="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:id="@+id/review_event_name"
                        android:textColor="@color/ui_ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/review_edit_details"
            style="@style/Widget.Ui.Button.Outline"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:contentDescription="@string/review_edit_details"
                        android:minWidth="64dp"
                        android:text="@string/venue_edit"
                        android:textColor="@color/ui_green" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/review_event_venue"
                    android:textColor="@color/ui_secondary_text"
                    android:textSize="13sp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/ui_divider" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:id="@+id/review_event_schedule"
                    android:textColor="@color/ui_ink"
                    android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ui_wash"
                android:orientation="vertical"
                android:paddingHorizontal="14dp">
                <include
                    android:id="@+id/review_venue_section"
                    layout="@layout/item_review_section" />
                <View style="@style/ReviewSectionDivider" />
                <include
                    android:id="@+id/review_phases_section"
                    layout="@layout/item_review_section" />
                <View style="@style/ReviewSectionDivider" />
                <include
                    android:id="@+id/review_channels_section"
                    layout="@layout/item_review_section" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/review_join_code_note"
                android:textColor="@color/ui_secondary_text"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/review_footer_back_button"
            style="@style/Widget.Ui.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:text="@string/back"
            android:textColor="@color/ui_green" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/review_create_button"
            style="@style/Widget.Ui.Button.Orange"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/create_event"
            android:textColor="@color/ui_surface" />
    </LinearLayout>
</LinearLayout>