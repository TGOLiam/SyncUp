<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/venue_layout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_surface"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">
        <include layout="@layout/create_event_progress" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ui_wash">
            <com.example.sync_up.VenueDrawingView
                android:id="@+id/venue_drawing"
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/venue_drawing_description" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/venue_draw_button"
                style="@style/VenueToolButton"
                android:text="@string/venue_draw" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/venue_edit_button"
                style="@style/VenueToolButton"
                android:text="@string/venue_edit" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/venue_undo_button"
                style="@style/VenueToolButton"
                android:text="@string/venue_undo" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/venue_simplify_button"
                style="@style/VenueToolButton"
                android:text="@string/venue_simplify" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/venue_clear_button"
            style="@style/Widget.Ui.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/venue_clear"
            android:textColor="@color/ui_green" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/venue_add_zone_button"
            style="@style/Widget.Ui.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/venue_add_zone"
            android:textColor="@color/ui_green" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/venue_footer_back_button"
            style="@style/Widget.Ui.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:text="@string/back"
            android:textColor="@color/ui_green" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/venue_next_button"
            style="@style/Widget.Ui.Button.Orange"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/next"
            android:textColor="@color/ui_surface" />
    </LinearLayout>
</LinearLayout>