<?xml version="1.0" encoding="utf-8"?>
<!--
    UI revision example 01: centered 40sp two-color wordmark with "Loading…"
    beneath. Session routing logic stays in MainActivity; no progress bar is
    shown, matching the approved screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_surface"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <include
        android:id="@+id/loading_wordmark"
        layout="@layout/ui_wordmark" />

    <TextView
        android:id="@+id/loading_caption"
        style="@style/TextAppearance.Ui.Supporting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/loading_caption" />

</LinearLayout>
