<?xml version="1.0" encoding="utf-8"?>
<!-- Ref 18: report-location dialog over the dimmed Event Area. Zone rows
     are added at runtime; Cancel dismisses without reporting. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/report_zone_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/report_zone_cancel"
        style="@style/Widget.Ui.Button.Outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="44dp"
        android:text="@string/cancel" />
</LinearLayout>
