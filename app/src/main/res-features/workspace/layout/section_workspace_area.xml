<?xml version="1.0" encoding="utf-8"?>
<!-- Revised Overview (event-area prototype). Current-phase card opens the
     phases section, organizers entry carries the overlapping avatar stack,
     the venue map hides behind a clickable card, and the report sheet is
     reached from Your last report plus the pinned Report my location. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="96dp">

            <!-- Current phase card; tapping it opens the phases section. -->
            <LinearLayout
                android:id="@+id/workspace_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ui_button_green"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/workspace_phase_caption"
                    style="@style/TextAppearance.Ui.Mono.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ui_phase_caption" />

                <LinearLayout
                    android:id="@+id/workspace_phase_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/workspace_phase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_600"
                    android:letterSpacing="-0.02"
                    android:text="@string/event_no_phase"
                    android:textColor="@color/ui_outgoing_text"
                    android:textSize="24sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Weighted Next line always anchors left; empty when
                         there is nothing coming, so View phases stays right. -->
                    <TextView
                        android:id="@+id/workspace_phase_next"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start|center_vertical"
                        android:textColor="@color/ui_phase_caption"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/workspace_phase_open"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/dm_sans_600"
                        android:paddingStart="8dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="6dp"
                        android:text="@string/workspace_view_phases"
                        android:textColor="@color/ui_outgoing_text"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Organizers entry: one clickable row with overlapping avatars. -->
            <LinearLayout
                android:id="@+id/workspace_organizers_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/dm_sans_600"
                        android:text="@string/workspace_organizers"
                        android:textColor="@color/ui_ink"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/workspace_organizers_subtitle"
                        style="@style/TextAppearance.Ui.Supporting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/workspace_organizer_avatars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="horizontal" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/workspace_organizers"
                    android:src="@drawable/ic_ui_chevron_right"
                    app:tint="@color/ui_action_gray" />
            </LinearLayout>

            <!-- Section divider between Organizers and Event layout. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/ui_divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/dm_sans_600"
                android:text="@string/workspace_venue_heading"
                android:textColor="@color/ui_ink"
                android:textSize="18sp" />

            <!-- Venue card; it grows to hold the layout when tapped so the
                 drawing sits on the same panel background. -->
            <LinearLayout
                android:id="@+id/workspace_venue_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_ui_venue_panel"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/workspace_venue_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/dm_sans_600"
                            android:textColor="@color/ui_ink"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/workspace_venue_hint"
                            style="@style/TextAppearance.Ui.Supporting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/workspace_view_layout_hint" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/workspace_venue_chevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/workspace_layout_description"
                        android:src="@drawable/ic_ui_chevron_right"
                        app:tint="@color/ui_action_gray" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/workspace_venue_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone">

                    <com.example.sync_up.WorkspaceLayoutView
                        android:id="@+id/workspace_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/workspace_layout_description" />

                    <TextView
                        android:id="@+id/workspace_empty_layout"
                        style="@style/TextAppearance.Ui.Supporting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="16dp"
                        android:text="@string/workspace_no_layout"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- Section divider between Event layout and Your last report. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/ui_divider" />

            <!-- Your last report: plain block, Update opens the report sheet. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/dm_sans_600"
                    android:text="@string/workspace_last_report"
                    android:textColor="@color/ui_ink"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/workspace_last_report_update"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/dm_sans_600"
                    android:paddingStart="8dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="6dp"
                    android:text="@string/workspace_last_report_update"
                    android:textColor="@color/ui_action_gray"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/workspace_last_report"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ui_row_divider"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/workspace_last_report_zone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans_600"
                    android:text="@string/workspace_last_report_none"
                    android:textColor="@color/ui_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/workspace_last_report_time"
                    style="@style/TextAppearance.Ui.Supporting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/workspace_not_reported" />
            </LinearLayout>

            <!-- Recent activity: heading row with a View all toggle. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/dm_sans_600"
                    android:text="@string/workspace_recent_activity"
                    android:textColor="@color/ui_ink"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/workspace_activity_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/dm_sans_600"
                    android:paddingStart="8dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="6dp"
                    android:text="@string/workspace_view_all"
                    android:textColor="@color/ui_action_gray"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/workspace_reports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/workspace_reports_empty"
                style="@style/TextAppearance.Ui.Supporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/workspace_no_reports" />
        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/workspace_report_location"
        style="@style/Widget.Ui.Button.Orange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:minHeight="48dp"
        android:text="@string/workspace_report_location" />
</FrameLayout>
