<?xml version="1.0" encoding="utf-8"?>
<!-- Ref 16: Event Area. Dark happening-now banner, organizers entry row,
     proportional venue map, report log rows, and the Report my location
     primary action pinned above the shared navigation. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="96dp">

            <LinearLayout
                android:id="@+id/workspace_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ui_button_green"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <TextView
                    style="@style/TextAppearance.Ui.Mono.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/workspace_happening_now"
                    android:textColor="@color/ui_phase_caption" />

                <TextView
                    android:id="@+id/workspace_phase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans_600"
                    android:text="@string/event_no_phase"
                    android:textColor="@color/ui_outgoing_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/workspace_organizers_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ui_row_divider"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextAppearance.Ui.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/workspace_organizers" />

                    <TextView
                        android:id="@+id/workspace_organizer_count"
                        style="@style/TextAppearance.Ui.Mono.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:fontFamily="@font/noto_sans_mono_600"
                        android:textColor="@color/ui_orange" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.Ui.Supporting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/workspace_organizers_hint" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ui_wash">
                <com.example.sync_up.WorkspaceLayoutView
                    android:id="@+id/workspace_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/workspace_layout_description" />
                <TextView
                    android:id="@+id/workspace_empty_layout"
                    style="@style/TextAppearance.Ui.Supporting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="@string/workspace_no_layout"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                style="@style/TextAppearance.Ui.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/workspace_report_log" />

            <LinearLayout
                android:id="@+id/workspace_reports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/workspace_reports_empty"
                style="@style/TextAppearance.Ui.Supporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/workspace_no_reports" />
        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/workspace_report_location"
        style="@style/Widget.Ui.Button.Orange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:minHeight="48dp"
        android:text="@string/workspace_report_location" />
</FrameLayout>
