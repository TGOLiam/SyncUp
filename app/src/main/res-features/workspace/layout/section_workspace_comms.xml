<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/event_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

        <ScrollView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:fillViewport="true">

            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="vertical">

                <LinearLayout

                    android:id="@+id/comms_channel_list"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:background="@drawable/workspace_card"

                    android:orientation="vertical"

                    android:paddingHorizontal="14dp"

                    android:paddingVertical="4dp" />

                <TextView

                    android:id="@+id/comms_history_title"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:textColor="@color/event_muted"

                    android:textSize="14sp"

                    android:textStyle="bold" />

                <TextView

                    android:id="@+id/comms_empty_history"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="10dp"

                    android:text="@string/comms_empty_history"

                    android:textColor="@color/event_muted"

                    android:textSize="14sp" />
                <LinearLayout
                    android:id="@+id/comms_messages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout

            android:id="@+id/comms_history_tabs"

            android:layout_width="match_parent"

            android:layout_height="48dp"

            android:background="@drawable/comms_segment_border"

            android:clipToOutline="true"

            android:orientation="horizontal"

            android:padding="2dp" />

        <LinearLayout

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:gravity="center_vertical"

            android:orientation="horizontal">

            <EditText

                android:id="@+id/comms_message"

                style="@style/CreateEventField"

                android:layout_width="0dp"

                android:layout_height="48dp"

                android:layout_marginTop="0dp"

                android:layout_weight="1"

                android:inputType="textCapSentences" />

            <com.google.android.material.button.MaterialButton

                android:id="@+id/comms_send"

                style="@style/Widget.Material3.Button.OutlinedButton"

                android:layout_width="wrap_content"

                android:layout_height="48dp"

                android:layout_marginStart="8dp"

                android:text="@string/comms_send"

                android:textAllCaps="false"

                android:textColor="@color/event_navy"

                app:cornerRadius="10dp"

                app:strokeColor="@color/event_navy" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton

            android:id="@+id/comms_push_to_talk"

            android:layout_width="match_parent"

            android:layout_height="60dp"

            android:layout_marginTop="8dp"

            android:textAllCaps="false"

            android:textColor="@color/white"

            app:backgroundTint="@color/event_navy"

            app:cornerRadius="10dp"

            app:icon="@drawable/ic_workspace_microphone"

            app:iconGravity="textStart"

            app:iconTint="@color/white" />
    </LinearLayout>


