<?xml version="1.0" encoding="utf-8"?>
<!-- Refs 19-20: Communications. Balanced connection panel with Global row
     and the custom picker trigger; history bubbles; fixed composer with
     segment tabs, message input, and the orange push-to-talk action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_surface"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Connection panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/comms_channel_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <View style="@style/UiPanelDivider" />
            </LinearLayout>

            <!-- History -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/comms_history_title"
                    style="@style/TextAppearance.Ui.Mono.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ui_secondary_text" />

                <TextView
                    android:id="@+id/comms_empty_history"
                    style="@style/TextAppearance.Ui.Supporting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:text="@string/comms_empty_history" />

                <LinearLayout
                    android:id="@+id/comms_messages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Composer footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ui_top_divider"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/comms_history_tabs"
            android:layout_width="384dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_ui_tabs_track"
            android:orientation="horizontal"
            android:padding="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/comms_message"
                style="@style/Widget.Ui.Field"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ui_field"
                android:hint="@string/comms_message_hint"
                android:inputType="textCapSentences" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/comms_send"
                style="@style/Widget.Ui.Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="72dp"
                android:text="@string/comms_send" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/comms_push_to_talk"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ui_button_orange"
            android:fontFamily="@font/dm_sans_600"
            android:textAllCaps="false"
            android:textColor="@color/ui_outgoing_text"
            app:backgroundTint="@color/ui_orange"
            app:cornerRadius="4dp"
            app:icon="@drawable/ic_workspace_microphone"
            app:iconGravity="textStart"
            app:iconTint="@color/ui_outgoing_text" />
    </LinearLayout>
</LinearLayout>
