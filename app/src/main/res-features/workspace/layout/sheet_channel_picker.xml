<?xml version="1.0" encoding="utf-8"?>
<!-- Handoff §7 custom channel picker: modal bottom sheet with handle,
     heading, guidance, search field, and filterable channel rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ui_sheet"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_ui_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextAppearance.Ui.SheetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/comms_picker_title" />

        <ImageButton
            android:id="@+id/picker_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/comms_picker_close"
            android:padding="12dp"
            android:src="@drawable/ic_ui_close"
            app:tint="@color/ui_ink" />
    </LinearLayout>

    <TextView
        style="@style/TextAppearance.Ui.Supporting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/comms_picker_guidance" />

    <EditText
        android:id="@+id/picker_search"
        style="@style/Widget.Ui.Field"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_ui_field"
        android:hint="@string/comms_picker_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text" />

    <LinearLayout
        android:id="@+id/picker_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/picker_empty"
        style="@style/TextAppearance.Ui.Supporting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="@string/comms_picker_empty"
        android:visibility="gone" />
</LinearLayout>
