<?xml version="1.0" encoding="utf-8"?>
<!-- Condensed display family for prominent headings and dialog titles. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/barlow_condensed_500"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/barlow_condensed_500"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/barlow_condensed_600"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/barlow_condensed_600"
        app:fontStyle="normal"
        app:fontWeight="600" />
</font-family>
