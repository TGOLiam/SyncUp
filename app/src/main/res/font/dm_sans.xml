<?xml version="1.0" encoding="utf-8"?>
<!-- Primary app typeface. Static bundled instances preserve genuine weights. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/dm_sans_400"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/dm_sans_400"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/dm_sans_500"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/dm_sans_500"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/dm_sans_600"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/dm_sans_600"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/dm_sans_700"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/dm_sans_700"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
