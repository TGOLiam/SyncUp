{
    admin off
}

{$SYNCUP_DOMAIN} {
    # Public IP certificates require Let's Encrypt's short-lived profile.
    tls {
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            profile shortlived
            disable_tlsalpn_challenge
        }
    }

    handle /livekit/* {
        reverse_proxy 127.0.0.1:54326
    }

    handle /rtc* {
        reverse_proxy 127.0.0.1:7883
    }

    respond "Not found" 404
}
